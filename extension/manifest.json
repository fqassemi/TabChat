{
  "manifest_version": 3,
  "name": "TabChat",
  "version": "1.0",
  "description": "TabChat",
  "permissions": ["tabs", "debugger", "storage", "activeTab", "scripting", "identity", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {}
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "oauth2": {
    "client_id": "366233102807-2finhnefuqoudh4oh4bpsejl9dfpullu.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}
